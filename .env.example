# =========================================
# Project: Pahatid System Project
# File: .env.example
# Description: Template for environment variables. 
# NOTE: In our Static+Supabase architecture, keys are embedded in assets/js/config.js 
# because GitHub Pages cannot read .env files at runtime. 
# This file exists for documentation and local development testing purposes only.
# Author: Pahatid System
# Date: 2026-09-30
# Version: 3.0.0
# =========================================

# SUPABASE CONFIGURATION
# Find these in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# APP CONFIGURATION
APP_NAME="Pahatid System"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# MAP PROVIDERS (Optional - currently using free OpenStreetMap via Leaflet)
MAPBOX_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# MAIL CONFIGURATION (For notifications/receipts - Future Feature)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION=tls

# SITE SETTINGS DEFAULTS
DEFAULT_LANGUAGE=en
BASE_FARE_RATE=40.00
KM_RATE=15.00
COMMISSION_RATE_PERCENT=20.00
